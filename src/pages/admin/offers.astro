---
import Layout from '../../layouts/Layout.astro';
import AdminNavbar from '../../components/AdminNavbar.astro';
---

<Layout title="Gestión de Ofertas - SEMAH Store">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-2">Ofertas de Clientes</h1>
    
    <AdminNavbar />
    
    <div class="grid grid-cols-1 gap-6 mt-6">
      <div class="bg-amber-50 border border-amber-200 rounded-lg p-8 text-center">
        <div class="flex justify-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <h2 class="text-2xl font-semibold text-amber-900 mb-2">Sistema de Ofertas Deshabilitado</h2>
        <p class="text-amber-800 mb-4">
          El sistema de ofertas ha sido deshabilitado. Ahora todos los productos tienen un descuento automático del 50%.
        </p>
        <p class="text-sm text-amber-700">
          Las reservas se crean directamente con el precio con descuento aplicado.
        </p>
      </div>
    </div>
  </main>
</Layout>
